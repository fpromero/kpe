# Downloaded models, NLP resources and caches
.cache/
models/
nltk_data/

# Generated experiment outputs
results/runs/*
results/figures/*
results/tables/*
results/statistical_tests/*
!results/runs/.gitkeep
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/statistical_tests/.gitkeep

# Notebook state
.ipynb_checkpoints/

# Build artifacts
build/
dist/

# Temporary files
tmp/
*.log
