*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Downloaded datasets and derived corpora
data/raw/*
